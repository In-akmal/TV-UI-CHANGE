<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_elevated" />
            <stroke android:width="2dp" android:color="@color/color_accent" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface_elevated" />
            <stroke android:width="2dp" android:color="@color/color_focus_border" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#593875F6" />
            <stroke android:width="1.5dp" android:color="@color/color_accent" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
            <stroke android:width="1dp" android:color="@color/color_divider" />
            <corners android:radius="@dimen/card_radius" />
        </shape>
    </item>
</selector>
